generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("Terapeuta")
  phone     String   @default("")
  specialty String   @default("Terapeuta Ocupacional")
  currency  String   @default("CLP")
  country   String   @default("CL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  calendarToken    String    @default("")

  @@index([calendarToken])
}

model Pipeline {
  centerId  String?
  center    Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  id        String           @id @default(cuid())
  name      String
  createdBy String           @default("")
  createdAt DateTime         @default(now())
  columns   PipelineColumn[]
}

model Patient {
  id            Int      @id @default(autoincrement())
  centerId      String?
  center        Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  /// Terapeuta a cargo del caso dentro del Centro
  therapistEmail String  @default("")
  /// centro | domicilio | ambos
  attendanceMode String  @default("centro")
  /// Dirección donde se atiende cuando es a domicilio
  homeAddress   String   @default("")
  name          String
  age           Int
  birthDate     String   @default("")
  guardian      String   @default("")
  guardianPhone String   @default("")
  guardianEmail String   @default("")
  prevision     String   @default("")
  coverageEntity String  @default("")
  school        String   @default("")
  consultReason String   @default("")
  sessionValue  Int      @default(0)
  diagnosis   String
  therapist   String   @default("Josefina P.")
  sessions    Int      @default(0)
  nextSession String   @default("")
  nextSessionTime String @default("")
  status      String   @default("activo")
  initials    String
  color       String   @default("from-violet-500 to-purple-600")
  phone       String   @default("")
  email       String   @default("")
  rut         String   @default("")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks          Task[]
  internalNotes  InternalNote[]
  pipelineCases  PipelineCase[]
  sessionRecords SessionRecord[]
  objectives     Objective[]
  reports        GeneratedReport[]
  documents      Document[]
  packages       SessionPackage[]
  formResponses  FormResponse[]
}

model Objective {
  id        Int      @id @default(autoincrement())
  patientId Int
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title     String
  status    String   @default("activo")
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

model GeneratedReport {
  centerId  String?
  center    Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  id        Int      @id @default(autoincrement())
  patientId Int?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type      String   @default("informe")
  title     String
  content   String
  createdBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdBy])
}

model PlanTier {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  plan         String
  maxPatients  Int?
  therapists   Int      @default(1)
  aiCredits    Int      @default(0)
  priceMonthly Int
  priceYearly  Int
  isAddon      Boolean  @default(false)
  notes        String   @default("")
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AiFeature {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  creditCost  Int
  esencial    Boolean  @default(false)
  profesional Boolean  @default(true)
  centro      Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CreditPack {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  credits   Int
  price     Int
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  type            String
  value           Int
  maxRedemptions  Int?
  redemptions     Int       @default(0)
  validUntil      DateTime?
  planRestriction String?
  description     String    @default("")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Subscription {
  id                   Int       @id @default(autoincrement())
  userEmail            String    @unique
  tierCode             String
  status               String    @default("trialing")
  billingCycle         String    @default("monthly")
  stripeCustomerId     String    @default("")
  stripeSubscriptionId String    @default("")
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  includedCreditsUsed  Int       @default(0)
  purchasedCredits     Int       @default(0)
  trialCredits         Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model CreditLedger {
  id         Int      @id @default(autoincrement())
  userEmail  String
  featureKey String   @default("")
  amount     Int
  reason     String   @default("")
  createdAt  DateTime @default(now())

  @@index([userEmail, createdAt])
}

model PricingSetting {
  key       String   @id
  value     String
  label     String   @default("")
  updatedAt DateTime @updatedAt
}

model Reminder {
  centerId  String?
  center    Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  date        String   @default("")
  time        String   @default("")
  type        String   @default("general")
  done        Boolean  @default(false)
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SessionRecord {
  id        Int      @id @default(autoincrement())
  patientId Int
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date      String
  notes     String   @default("")
  therapist String   @default("")
  duration  Int      @default(45)
  attended  Boolean  @default(true)
  paid      Boolean  @default(false)
  value     Int?
  confirmed Boolean  @default(true)
  appointmentId Int?  @unique
  packageId Int?
  package   SessionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  createdBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, date])
}

model Task {
  centerId  String?
  /// A quién se la asignó la Administradora; vacío = es suya
  assignedTo String  @default("")
  /// Comentario que deja la terapeuta al resolverla
  comment    String  @default("")
  center    Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  priority    String   @default("media")
  status      String   @default("pendiente")
  due         String   @default("")
  time        String   @default("")
  notify      Boolean  @default(false)
  notifiedAt  DateTime?
  category    String   @default("Clínico")
  patientName String   @default("")
  patientId   Int?
  patient     Patient? @relation(fields: [patientId], references: [id])
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([notify, notifiedAt])
}

model Appointment {
  centerId  String?
  /// Quién la agendó cuando no fue la propia terapeuta
  scheduledBy String @default("")
  center    Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  id        Int      @id @default(autoincrement())
  title     String
  date      String
  time      String
  type      String   @default("sesion")
  location  String   @default("")
  patientId Int?
  duration  Int      @default(45)
  status    String   @default("agendada")
  createdBy String   @default("")
  createdAt DateTime @default(now())

  paid             Boolean @default(false)
  value            Int?
  convertedToSession Boolean @default(false)
  createdNotifSent Boolean @default(false)
  seriesId         String  @default("")
  reminder5dSent Boolean @default(false)
  reminder1dSent Boolean @default(false)
  reminder4hSent Boolean @default(false)
}

model PipelineColumn {
  id         String   @id @default(cuid())
  label      String
  color      String
  accent     String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  cases      PipelineCase[]
}

model PipelineCase {
  id        Int            @id @default(autoincrement())
  patient   String
  age       Int
  diagnosis String
  therapist String         @default("JP")
  days      Int            @default(0)
  overdue   Boolean        @default(false)
  initials  String
  columnId  String
  column    PipelineColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  patientId Int?
  patientRef Patient?      @relation(fields: [patientId], references: [id])
  createdAt DateTime       @default(now())
}

model Document {
  centerId  String?
  center    Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  id        Int      @id @default(autoincrement())
  name      String
  category  String   @default("Sin categoría")
  size      String
  type      String
  key       String   @unique
  url       String
  patientId Int?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  createdBy String   @default("")
  createdAt DateTime @default(now())

  @@index([patientId])
}

model SessionPackage {
  centerId  String?
  center    Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  id            Int      @id @default(autoincrement())
  patientId     Int
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name          String   @default("")
  totalSessions Int
  sessionValue  Int      @default(0)
  totalPrice    Int      @default(0)
  paid          Boolean  @default(false)
  startDate     String   @default("")
  expiresAt     String   @default("")
  notes         String   @default("")
  status        String   @default("activo")
  createdBy     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions SessionRecord[]

  @@index([createdBy, status])
  @@index([patientId])
}

/// Formulario propio de la terapeuta: ficha de admisión, entrevista, pauta
model FormTemplate {
  centerId  String?
  center    Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  /// [{ id, title, fields: [{ id, label, type, options, required }] }]
  sections    Json
  origin      String   @default("propia")
  archived    Boolean  @default(false)
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  responses FormResponse[]

  @@index([createdBy, archived])
}

/// Una plantilla llenada para un paciente
model FormResponse {
  id         Int          @id @default(autoincrement())
  templateId Int
  template   FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  patientId  Int
  patient    Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title      String       @default("")
  /// { fieldId: valor }
  answers    Json
  createdBy  String       @default("")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([patientId])
  @@index([templateId])
}

/// Un centro de terapia: una Administradora y hasta N terapeutas
model Center {
  id             String   @id @default(cuid())
  name           String
  logoUrl        String   @default("")
  address        String   @default("")
  taxId          String   @default("")
  phone          String   @default("")
  /// centro | domicilio | ambos
  attendanceMode String   @default("ambos")
  country        String   @default("CL")
  currency       String   @default("CLP")
  /// Cupos incluidos en el plan y cupos extra comprados
  seats          Int      @default(5)
  extraSeats     Int      @default(0)
  /// Correo de la Administradora: hay una sola por Centro
  adminEmail     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members     CenterMember[]
  patients    Patient[]
  appointments Appointment[]
  tasks       Task[]
  documents   Document[]
  reports     GeneratedReport[]
  packages    SessionPackage[]
  templates   FormTemplate[]
  reminders   Reminder[]
  pipelines   Pipeline[]

  @@index([adminEmail])
}

/// Cada persona del Centro, con sus permisos
model CenterMember {
  id          String    @id @default(cuid())
  /// Horario de atención: { lun: [{desde,hasta}], mar: [...] }
  schedule    Json?
  centerId    String
  center      Center    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  userEmail   String
  name        String    @default("")
  /// administradora | terapeuta
  role        String    @default("terapeuta")
  active      Boolean   @default(true)
  /// { verTodosPacientes, crearPacientes, enviarInformes, registrarPagos, descargarDatos, crearPlantillas }
  permissions Json
  inviteToken String?   @unique
  invitedAt   DateTime  @default(now())
  joinedAt    DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([centerId, userEmail])
  @@index([userEmail, active])
}

/// Nota interna del equipo sobre un paciente: nunca sale en un informe
model InternalNote {
  id        Int      @id @default(autoincrement())
  patientId Int
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  centerId  String?
  body      String
  authorName String  @default("")
  createdBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}
