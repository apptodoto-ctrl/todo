generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("Terapeuta")
  phone     String   @default("")
  specialty String   @default("Terapeuta Ocupacional")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resetToken       String?   @unique
  resetTokenExpiry DateTime?
}

model Pipeline {
  id        String           @id @default(cuid())
  name      String
  createdBy String           @default("")
  createdAt DateTime         @default(now())
  columns   PipelineColumn[]
}

model Patient {
  id            Int      @id @default(autoincrement())
  name          String
  age           Int
  birthDate     String   @default("")
  guardian      String   @default("")
  guardianPhone String   @default("")
  prevision     String   @default("")
  school        String   @default("")
  consultReason String   @default("")
  sessionValue  Int      @default(0)
  diagnosis   String
  therapist   String   @default("Josefina P.")
  sessions    Int      @default(0)
  nextSession String   @default("")
  status      String   @default("activo")
  initials    String
  color       String   @default("from-violet-500 to-purple-600")
  phone       String   @default("")
  email       String   @default("")
  rut         String   @default("")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks          Task[]
  pipelineCases  PipelineCase[]
  sessionRecords SessionRecord[]
  objectives     Objective[]
  reports        GeneratedReport[]
}

model Objective {
  id        Int      @id @default(autoincrement())
  patientId Int
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title     String
  status    String   @default("activo")
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

model GeneratedReport {
  id        Int      @id @default(autoincrement())
  patientId Int?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type      String   @default("informe")
  title     String
  content   String
  createdBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdBy])
}

model Reminder {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  date        String   @default("")
  time        String   @default("")
  type        String   @default("general")
  done        Boolean  @default(false)
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SessionRecord {
  id        Int      @id @default(autoincrement())
  patientId Int
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date      String
  notes     String   @default("")
  therapist String   @default("")
  duration  Int      @default(45)
  attended  Boolean  @default(true)
  paid      Boolean  @default(false)
  createdBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, date])
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  priority    String   @default("media")
  status      String   @default("pendiente")
  due         String   @default("")
  category    String   @default("Clínico")
  patientName String   @default("")
  patientId   Int?
  patient     Patient? @relation(fields: [patientId], references: [id])
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Appointment {
  id        Int      @id @default(autoincrement())
  title     String
  date      String
  time      String
  type      String   @default("sesion")
  location  String   @default("")
  patientId Int?
  duration  Int      @default(45)
  status    String   @default("agendada")
  createdBy String   @default("")
  createdAt DateTime @default(now())
}

model PipelineColumn {
  id         String   @id @default(cuid())
  label      String
  color      String
  accent     String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  cases      PipelineCase[]
}

model PipelineCase {
  id        Int            @id @default(autoincrement())
  patient   String
  age       Int
  diagnosis String
  therapist String         @default("JP")
  days      Int            @default(0)
  overdue   Boolean        @default(false)
  initials  String
  columnId  String
  column    PipelineColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  patientId Int?
  patientRef Patient?      @relation(fields: [patientId], references: [id])
  createdAt DateTime       @default(now())
}

model Document {
  id        Int      @id @default(autoincrement())
  name      String
  category  String   @default("Sin categoría")
  size      String
  type      String
  key       String   @unique
  url       String
  createdBy String   @default("")
  createdAt DateTime @default(now())
}
